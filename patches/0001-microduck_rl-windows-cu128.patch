+def test_win32_resolution_uses_a_cuda_index():
+    """Windows must not resolve torch to PyPI's CPU-only wheel.
+
+    `pip install torch` on Windows from PyPI yields 2.9.1+cpu with
+    torch.version.cuda is None, so torch.cuda.device_count() == 0 and
+    mjlab's select_gpus() indexes an empty list -> IndexError before
+    training starts (mjlab/utils/gpu.py:70). The same failure mode as
+    aarch64, for the same reason, with a different cause: Linux carries
+    CUDA in the nvidia-*-cu12 dependencies, Windows carries it inside the
+    torch wheel itself — and PyPI's Windows wheel is the CPU one.
+    """
+    win32 = [
+        p for p in _packages("torch") if "sys_platform == 'win32'" in _markers(p)
+    ]
+    assert win32, "no win32-scoped torch entry -> Windows gets PyPI's CPU-only wheel"
+    for pkg in win32:
+        assert _registry(pkg).startswith(_CUDA_INDEX), (
+            f"win32 torch comes from {_registry(pkg)!r} — a CPU wheel. "
+            "Re-run `uv lock` after checking [tool.uv.sources]."
+        )
+        assert "+cu" in pkg["version"], "the win32 wheel has no +cuXXX local version"
+    # torchvision must follow torch onto the CUDA index, or a CPU torchvision
+    # ends up next to a CUDA torch.
+    tv = [
+        p
+        for p in _packages("torchvision")
+        if "sys_platform == 'win32'" in _markers(p)
+    ]
+    assert tv, "no win32-scoped torchvision entry"
+    for pkg in tv:
+        assert _registry(pkg).startswith(_CUDA_INDEX), (
+            f"win32 torchvision comes from {_registry(pkg)!r} — a CPU wheel."
+        )
+
+
