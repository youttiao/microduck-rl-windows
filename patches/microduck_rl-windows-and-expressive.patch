+    "Tremendous-V3-Bold": DataMotion("Tremendous-V3-Bold", 18.25, "tremendous_v3_bold.csv", overspeed=8.0,
+                                     note=_V3_NOTE + "; BOLD: the same key poses, harder dynamics (design 6.5 / 8 rad/s, "
