diff --git a/src/mjlab_microduck/tasks/mdp.py b/src/mjlab_microduck/tasks/mdp.py
index 41903ce..14fc3d7 100644
--- a/src/mjlab_microduck/tasks/mdp.py
+++ b/src/mjlab_microduck/tasks/mdp.py
@@ -7705,3 +7705,821 @@ def roulade_lateral_velocity_penalty(
     """Body-frame lateral (y) linear velocity² — keeps the roll straight."""
     asset: Entity = env.scene[asset_cfg.name]
     return torch.nan_to_num(asset.data.root_link_lin_vel_b[:, 1].pow(2), nan=0.0)
+
+
+# --------------------------------------------------------------------------- #
+# Ground grasp (2026-10-10): the ground-pick slot with an opening beak and a   #
+# real object to grasp. Robot / object entities: robot/ground_grasp.py.        #
+# Design: docs/superpowers/specs/2026-10-10-ground-grasp-design.md             #
+# --------------------------------------------------------------------------- #
+from mjlab.managers.action_manager import ActionTerm as _ActionTerm, ActionTermCfg as _ActionTermCfg  # noqa: E402
+
+
+def _gg_cache(env: ManagerBasedRlEnv) -> dict:
+    return env.__dict__.setdefault("_ground_grasp_cache", {})
+
+
+def _gg_buffer(env: ManagerBasedRlEnv, name: str, dim: int) -> torch.Tensor:
+    c = _gg_cache(env)
+    if name not in c:
+        c[name] = torch.zeros(env.num_envs, dim, device=env.device)
+    return c[name]
+
+
+@_dataclass(kw_only=True)
+class MouthScheduleActionCfg(_ActionTermCfg):
+    """Scripted mouth: opens on the way down, closes at the floor — NOT a policy output (action_dim 0, so the
+    14-action contract is untouched). The jaw target follows the phase of `command_name`:
+    closed until open_start, ramps to open by open_end, holds, ramps closed over [close_start, close_end], closed
+    after (squeezing whatever is between the pads). Per-episode DR: open angle x U(open_scale_range), closing
+    shifted by U(-close_jitter, close_jitter)."""
+
+    joint_name: str = "passive_mouth"
+    command_name: str = "twist"
+    closed_rad: float = -0.0873
+    open_rad: float = 0.45
+    open_start: float = 0.02
+    open_end: float = 0.10
+    close_start: float = 0.30
+    close_end: float = 0.36
+    open_scale_range: tuple = (0.9, 1.05)
+    close_jitter: float = 0.01
+
+    def build(self, env: ManagerBasedRlEnv) -> "MouthScheduleAction":
+        return MouthScheduleAction(self, env)
+
+
+def mouth_schedule_fraction(phase: torch.Tensor, open_start: float, open_end: float,
+                            close_start: torch.Tensor | float, close_end: torch.Tensor | float) -> torch.Tensor:
+    """0 = closed, 1 = fully open, as a function of the phase (pure, testable)."""
+    o = torch.clamp((phase - open_start) / (open_end - open_start), 0.0, 1.0)
+    c = torch.clamp((phase - close_start) / (close_end - close_start), 0.0, 1.0)
+    return o * (1.0 - c)
+
+
+class MouthScheduleAction(_ActionTerm):
+    cfg: MouthScheduleActionCfg
+
+    def __init__(self, cfg: MouthScheduleActionCfg, env: ManagerBasedRlEnv):
+        super().__init__(cfg, env)
+        ids, _ = self._entity.find_joints(cfg.joint_name)
+        assert len(ids) == 1, f"mouth joint {cfg.joint_name!r} not found"
+        self._joint_ids = torch.tensor(ids, device=env.device, dtype=torch.long)
+        n = env.num_envs
+        self._raw = torch.zeros(n, 0, device=env.device)
+        self._open = torch.full((n,), cfg.open_rad, device=env.device)
+        self._shift = torch.zeros(n, device=env.device)
+        self._target = torch.full((n, 1), cfg.closed_rad, device=env.device)
+
+    @property
+    def action_dim(self) -> int:
+        return 0
+
+    @property
+    def raw_action(self) -> torch.Tensor:
+        return self._raw
+
+    def target(self) -> torch.Tensor:
+        cfg = self.cfg
+        phase = _gp_phase(self._env, cfg.command_name)
+        frac = mouth_schedule_fraction(phase, cfg.open_start, cfg.open_end,
+                                       cfg.close_start + self._shift, cfg.close_end + self._shift)
+        return cfg.closed_rad + frac * (self._open - cfg.closed_rad)
+
+    def process_actions(self, actions: torch.Tensor) -> None:
+        self._target[:, 0] = self.target()
+
+    def apply_actions(self) -> None:
+        self._entity.set_joint_position_target(self._target, joint_ids=self._joint_ids)
+
+    def reset(self, env_ids: torch.Tensor | slice | None = None) -> None:
+        cfg = self.cfg
+        if env_ids is None:
+            env_ids = slice(None)
+        n = self._open[env_ids].shape[0]
+        lo, hi = cfg.open_scale_range
+        self._open[env_ids] = cfg.open_rad * (lo + (hi - lo) * torch.rand(n, device=self._open.device))
+        self._shift[env_ids] = (torch.rand(n, device=self._open.device) * 2 - 1) * cfg.close_jitter
+        self._target[env_ids, 0] = cfg.closed_rad
+
+
+def _gg_object_half(env: ManagerBasedRlEnv, asset_name: str) -> torch.Tensor:
+    """(num_envs, 3) half-extents of the object's (single, box) geom — per env once dr.geom_size expanded it."""
+    obj: Entity = env.scene[asset_name]
+    gid = int(obj.indexing.geom_ids[0])
+    gs = env.sim.model.geom_size
+    if gs.dim() == 3:
+        return gs[:, gid, :]
+    return gs[gid].unsqueeze(0).expand(env.num_envs, 3)
+
+
+def reset_grasp_object(
+    env: ManagerBasedRlEnv,
+    env_ids: torch.Tensor,
+    nominal_xy: tuple = (0.11, 0.0),
+    noise_xy: tuple = (0.01, 0.01),
+    asset_name: str = "object",
+):
+    """Place the object on the floor at nominal_xy (robot yaw frame) + uniform noise, random yaw; store its spawn
+    position (object_spawn buffer). Reads the robot root from qpos (final after reset_base / set_ground_state):
+    register AFTER them and after the object size DR (events run in insertion order). The noise half-widths are
+    mutated by grasp_object_noise_curriculum."""
+    if env_ids is None or len(env_ids) == 0:
+        return
+    env_ids = env_ids.to(env.device)
+    robot: Entity = env.scene["robot"]
+    obj: Entity = env.scene[asset_name]
+    root = env.sim.data.qpos[env_ids][:, robot.indexing.free_joint_q_adr]
+    qw, qx, qy, qz = root[:, 3], root[:, 4], root[:, 5], root[:, 6]
+    yaw = torch.atan2(2.0 * (qw * qz + qx * qy), 1.0 - 2.0 * (qy * qy + qz * qz))
+    cy, sy = torch.cos(yaw), torch.sin(yaw)
+    n = len(env_ids)
+    noise = torch.tensor(noise_xy, device=env.device, dtype=torch.float)
+    off = torch.tensor(nominal_xy, device=env.device, dtype=torch.float).repeat(n, 1)
+    off += (torch.rand(n, 2, device=env.device) * 2.0 - 1.0) * noise
+    half = _gg_object_half(env, asset_name)[env_ids]
+    pose = torch.zeros(n, 7, device=env.device)
+    pose[:, 0] = root[:, 0] + cy * off[:, 0] - sy * off[:, 1]
+    pose[:, 1] = root[:, 1] + sy * off[:, 0] + cy * off[:, 1]
+    pose[:, 2] = env.scene.terrain.env_origins[env_ids, 2] + half[:, 2] + 0.0005
+    oyaw = (torch.rand(n, device=env.device) * 2 - 1) * math.pi
+    pose[:, 3] = torch.cos(oyaw / 2)
+    pose[:, 6] = torch.sin(oyaw / 2)
+    obj.write_root_link_pose_to_sim(pose, env_ids)
+    obj.write_root_link_velocity_to_sim(torch.zeros(n, 6, device=env.device), env_ids)
+    spawn = _gg_buffer(env, "object_spawn", 3)
+    spawn[env_ids] = pose[:, :3]
+
+
+def grasp_object_noise_curriculum(
+    env: ManagerBasedRlEnv,
+    env_ids: torch.Tensor,
+    event_name: str = "reset_object",
+    stages: list | None = None,
+) -> dict:
+    """Step-based widening of the object placement noise: stages = [{"step": s, "noise_xy": (nx, ny)}, ...]."""
+    stages = stages or []
+    step = env.common_step_counter
+    cur = None
+    for st in stages:
+        if step >= st["step"]:
+            cur = st["noise_xy"]
+    if cur is not None:
+        term = env.event_manager.get_term_cfg(event_name)
+        term.params["noise_xy"] = tuple(cur)
+        return {"noise_x": float(cur[0]), "noise_y": float(cur[1])}
+    return {}
+
+
+def _gg_grasp_point(env: ManagerBasedRlEnv) -> torch.Tensor:
+    """World position of the grasp point: midpoint of the two pad sites (pad_up on the head, pad_low on the jaw)."""
+    robot: Entity = env.scene["robot"]
+    c = _gg_cache(env)
+    if "pad_site_ids" not in c:
+        ids, _ = robot.find_sites(["pad_up", "pad_low"], preserve_order=True)
+        c["pad_site_ids"] = ids
+    ids = c["pad_site_ids"]
+    return 0.5 * (robot.data.site_pos_w[:, ids[0]] + robot.data.site_pos_w[:, ids[1]])
+
+
+def grasp_state(
+    env: ManagerBasedRlEnv,
+    asset_name: str = "object",
+    jaw_sensor: str = "object_jaw_contact",
+    upper_sensor: str = "object_upper_contact",
+    floor_sensor: str = "object_floor_contact",
+) -> dict:
+    """Per-step grasp booleans, cached on the step counter (several reward terms read them)."""
+    c = _gg_cache(env)
+    key = (env.common_step_counter, asset_name)
+    if c.get("grasp_state_key") == key:
+        return c["grasp_state"]
+    obj: Entity = env.scene[asset_name]
+    s = env.scene.sensors
+    jaw = s[jaw_sensor].data.found.reshape(env.num_envs, -1).sum(-1) > 0
+    upper = s[upper_sensor].data.found.reshape(env.num_envs, -1).sum(-1) > 0
+    floor = s[floor_sensor].data.found.reshape(env.num_envs, -1).sum(-1) > 0
+    spawn = _gg_buffer(env, "object_spawn", 3)
+    lift = obj.data.root_link_pos_w[:, 2] - spawn[:, 2]
+    pinched = jaw & upper
+    st = dict(jaw=jaw, upper=upper, floor=floor, pinched=pinched, lift=lift,
+              held=pinched & ~floor & (lift > 0.01))
+    c["grasp_state_key"] = key
+    c["grasp_state"] = st
+    return st
+
+
+def grasp_held(
+    env: ManagerBasedRlEnv,
+    command_name: str = "twist",
+    phase_start: float = 0.40,
+    asset_name: str = "object",
+) -> torch.Tensor:
+    """1 per step while the object is pinched between BOTH pads, off the floor and lifted >= 1 cm, for phase >=
+    phase_start (after the mouth has closed). The main task term."""
+    st = grasp_state(env, asset_name)
+    gate = (_gp_phase(env, command_name) >= phase_start).float()
+    return gate * st["held"].float()
+
+
+def grasp_lift(
+    env: ManagerBasedRlEnv,
+    command_name: str = "twist",
+    phase_start: float = 0.33,
+    max_lift: float = 0.04,
+    asset_name: str = "object",
+) -> torch.Tensor:
+    """Lift progress of a pinched object: clamp(lift / max_lift, 0, 1) while pinched and off the floor."""
+    st = grasp_state(env, asset_name)
+    gate = (_gp_phase(env, command_name) >= phase_start).float()
+    ok = (st["pinched"] & ~st["floor"]).float()
+    return gate * ok * torch.clamp(st["lift"] / max_lift, 0.0, 1.0)
+
+
+def grasp_approach_target(
+    env: ManagerBasedRlEnv,
+    phase: torch.Tensor,
+    asset_name: str = "object",
+    move_start: float = 0.05,
+    hover_at: float = 0.20,
+    down_at: float = 0.29,
+    hover_height: float = 0.06,
+    grasp_z_offset: float = 0.005,
+    top_offset: float = 0.0,
+) -> torch.Tensor:
+    """Slewed target for the grasp point: from its standing position (grasp_start buffer) to a hover point
+    hover_height above the grasp spot by phase hover_at, then STRAIGHT DOWN onto it by down_at. The grasp spot is
+    the object centre + grasp_z_offset (the pad midpoint cannot reach the centre of a floor object: the lips would
+    have to go through the floor), or, with top_offset > 0 (tall objects), top_offset below the object's top."""
+    obj: Entity = env.scene[asset_name]
+    p_obj = obj.data.root_link_pos_w + torch.tensor([0.0, 0.0, grasp_z_offset], device=env.device)
+    if top_offset > 0:
+        top = obj.data.root_link_pos_w[:, 2] + _gg_object_half(env, asset_name)[:, 2] - top_offset
+        p_obj = torch.cat([obj.data.root_link_pos_w[:, :2], top.unsqueeze(-1)], dim=-1)
+    start = _gg_buffer(env, "grasp_start", 3)
+    hover = p_obj + torch.tensor([0.0, 0.0, hover_height], device=env.device)
+    a = torch.clamp((phase - move_start) / (hover_at - move_start), 0.0, 1.0).unsqueeze(-1)
+    b = torch.clamp((phase - hover_at) / (down_at - hover_at), 0.0, 1.0).unsqueeze(-1)
+    first = start + a * (hover - start)
+    return torch.where(phase.unsqueeze(-1) < hover_at, first, hover + b * (p_obj - hover))
+
+
+def grasp_approach_track(
+    env: ManagerBasedRlEnv,
+    command_name: str = "twist",
+    std: float = 0.03,
+    phase_start: float = 0.05,
+    phase_end: float = 0.36,
+    move_start: float = 0.05,
+    hover_at: float = 0.20,
+    down_at: float = 0.29,
+    hover_height: float = 0.06,
+    asset_name: str = "object",
+    std_wide: float = 0.0,
+    top_offset: float = 0.0,
+) -> torch.Tensor:
+    """Gaussian tracking of the slewed approach target (above the object first, then a vertical descent).
+    Being ahead of the ramp pays nothing (AGENTS: no jackpots); a vertical final approach is the argmax.
+    std_wide > 0: half the pay comes from a second, wide Gaussian so a policy that starts far away (today's move
+    lands ~7 cm off the target) still sees a gradient."""
+    phase = _gp_phase(env, command_name)
+    tgt = grasp_approach_target(env, phase, asset_name, move_start, hover_at, down_at, hover_height,
+                                top_offset=top_offset)
+    d2 = (_gg_grasp_point(env) - tgt).pow(2).sum(-1)
+    gate = ((phase >= phase_start) & (phase < phase_end)).float()
+    r = torch.exp(-d2 / (std * std))
+    if std_wide > 0:
+        r = 0.5 * r + 0.5 * torch.exp(-d2 / (std_wide * std_wide))
+    return gate * r
+
+
+def record_grasp_start(
+    env: ManagerBasedRlEnv,
+    env_ids: torch.Tensor,
+    offset_b: tuple = (0.065, 0.0, 0.105),
+):
+    """Store the grasp point's standing position (root + yaw-rotated offset measured at HOME) as the start of
+    the approach target. Register after the robot reset events."""
+    if env_ids is None or len(env_ids) == 0:
+        return
+    env_ids = env_ids.to(env.device)
+    robot: Entity = env.scene["robot"]
+    root = env.sim.data.qpos[env_ids][:, robot.indexing.free_joint_q_adr]
+    qw, qx, qy, qz = root[:, 3], root[:, 4], root[:, 5], root[:, 6]
+    yaw = torch.atan2(2.0 * (qw * qz + qx * qy), 1.0 - 2.0 * (qy * qy + qz * qz))
+    cy, sy = torch.cos(yaw), torch.sin(yaw)
+    ox, oy, oz = offset_b
+    start = _gg_buffer(env, "grasp_start", 3)
+    start[env_ids, 0] = root[:, 0] + cy * ox - sy * oy
+    start[env_ids, 1] = root[:, 1] + sy * ox + cy * oy
+    start[env_ids, 2] = root[:, 2] + oz
+
+
+def object_push_penalty(
+    env: ManagerBasedRlEnv,
+    command_name: str = "twist",
+    phase_end: float = 0.36,
+    max_dist: float = 0.04,
+    asset_name: str = "object",
+) -> torch.Tensor:
+    """-min(horizontal displacement of the object from its spawn point, max_dist) / max_dist, while the mouth is
+    open or closing (phase < phase_end). Self-negating (<= 0): use a POSITIVE weight. This prices exactly what a
+    frontal or sideways approach does: push the object away."""
+    obj: Entity = env.scene[asset_name]
+    spawn = _gg_buffer(env, "object_spawn", 3)
+    d = torch.norm(obj.data.root_link_pos_w[:, :2] - spawn[:, :2], dim=-1)
+    gate = (_gp_phase(env, command_name) < phase_end).float()
+    return -gate * torch.clamp(d, max=max_dist) / max_dist
+
+
+def beak_pitch(env: ManagerBasedRlEnv) -> torch.Tensor:
+    """Beak pitch in degrees (0 = level as when standing, 90 = pointing straight down), full range."""
+    robot: Entity = env.scene["robot"]
+    c = _gg_cache(env)
+    if "head_body_id" not in c:
+        ids, _ = robot.find_bodies(["jaw_soft"])
+        c["head_body_id"] = ids[0]
+    q = robot.data.body_link_quat_w[:, c["head_body_id"]]
+    R = matrix_from_quat(q)            # head-local x = up, z = back
+    fwd_z = -R[:, 2, 2]
+    up_z = R[:, 2, 0]
+    return torch.rad2deg(torch.atan2(-fwd_z, up_z))
+
+
+def beak_pitch_pref(
+    env: ManagerBasedRlEnv,
+    command_name: str = "twist",
+    target_deg: float = 60.0,
+    std_deg: float = 15.0,
+    phase_start: float = 0.22,
+    phase_end: float = 0.36,
+) -> torch.Tensor:
+    """Optional shaping: Gaussian on beak pitch around target_deg during the grasp window."""
+    phase = _gp_phase(env, command_name)
+    gate = ((phase >= phase_start) & (phase < phase_end)).float()
+    return gate * torch.exp(-((beak_pitch(env) - target_deg) / std_deg) ** 2)
+
+
+def object_pos_rel_grasp_point(env: ManagerBasedRlEnv, asset_name: str = "object") -> torch.Tensor:
+    """CRITIC-ONLY: object position minus grasp point, in the robot base frame."""
+    robot: Entity = env.scene["robot"]
+    obj: Entity = env.scene[asset_name]
+    rel = obj.data.root_link_pos_w - _gg_grasp_point(env)
+    rot = matrix_from_quat(robot.data.root_link_quat_w)
+    return torch.bmm(rot.transpose(1, 2), rel.unsqueeze(-1)).squeeze(-1)
+
+
+def object_size_obs(env: ManagerBasedRlEnv, asset_name: str = "object") -> torch.Tensor:
+    """CRITIC-ONLY: object half-extents."""
+    return _gg_object_half(env, asset_name)
+
+
+def mouth_angle_obs(env: ManagerBasedRlEnv, joint_name: str = "passive_mouth") -> torch.Tensor:
+    """CRITIC-ONLY: jaw angle (rad)."""
+    robot: Entity = env.scene["robot"]
+    c = _gg_cache(env)
+    if "mouth_joint_id" not in c:
+        ids, _ = robot.find_joints(joint_name)
+        c["mouth_joint_id"] = ids[0]
+    return robot.data.joint_pos[:, c["mouth_joint_id"]].unsqueeze(-1)
+
+
+def grasp_contacts_obs(env: ManagerBasedRlEnv, asset_name: str = "object") -> torch.Tensor:
+    """CRITIC-ONLY: [object touches jaw pad, upper pad, floor]."""
+    st = grasp_state(env, asset_name)
+    return torch.stack([st["jaw"], st["upper"], st["floor"]], dim=-1).float()
+
+
+def joint_overspeed_penalty(
+    env: ManagerBasedRlEnv,
+    threshold: float = 5.0,
+    asset_cfg: SceneEntityCfg = _DEFAULT_ASSET_CFG,
+) -> torch.Tensor:
+    """-sum over the 14 servos of max(0, |qvel| - threshold)^2 (rad/s). Self-negating (<= 0): POSITIVE weight.
+    Free below the threshold, so slow big motions cost nothing; an XL330 tops out near 10-12 rad/s at 7.4 V and a
+    whip at that speed is what overheats and strips gears (Rémi's veto on thrashing)."""
+    asset = env.scene[asset_cfg.name]
+    v = _servo_joint_vel(env, asset)
+    return -torch.clamp(v.abs() - threshold, min=0.0).pow(2).sum(-1)
+
+
+def beak_bisector(env: ManagerBasedRlEnv) -> torch.Tensor:
+    """Angle of the open beak's bisector below horizontal, degrees: head pitch + jaw opening / 2 (the plane halfway
+    between the upper mandible and the jaw). 90 = Rémi's "beak from the sky": the mouth opens straight at the floor."""
+    return beak_pitch(env) + 0.5 * torch.rad2deg(mouth_angle_obs(env).squeeze(-1))
+
+
+def beak_bisector_pref(
+    env: ManagerBasedRlEnv,
+    command_name: str = "twist",
+    target_deg: float = 90.0,
+    std_deg: float = 10.0,
+    phase_start: float = 0.20,
+    phase_end: float = 0.33,
+) -> torch.Tensor:
+    """Gaussian on the beak bisector around target_deg during the final descent and the bite."""
+    phase = _gp_phase(env, command_name)
+    gate = ((phase >= phase_start) & (phase < phase_end)).float()
+    return gate * torch.exp(-((beak_bisector(env) - target_deg) / std_deg) ** 2)
+
+
+def approach_lateral_speed_penalty(
+    env: ManagerBasedRlEnv,
+    command_name: str = "twist",
+    height: float = 0.05,
+    phase_end: float = 0.30,
+    asset_name: str = "object",
+) -> torch.Tensor:
+    """-horizontal speed (m/s) of the grasp point while it is less than `height` above the object centre and the
+    mouth has not started closing. Self-negating (<= 0): POSITIVE weight. The last centimetres must come straight
+    down, or the beak sweeps the object (Rémi: "it goes sideways and then the beak collides with the ground")."""
+    c = _gg_cache(env)
+    gp = _gg_grasp_point(env)
+    prev = c.get("gp_prev")
+    c["gp_prev"] = gp.clone()
+    if prev is None or prev.shape != gp.shape:
+        return torch.zeros(env.num_envs, device=env.device)
+    v = torch.norm(gp[:, :2] - prev[:, :2], dim=-1) / env.step_dt
+    v = torch.where(env.episode_length_buf <= 1, torch.zeros_like(v), v)       # no jump across a reset
+    obj: Entity = env.scene[asset_name]
+    above = gp[:, 2] - obj.data.root_link_pos_w[:, 2]
+    gate = ((above < height) & (_gp_phase(env, command_name) < phase_end)).float()
+    return -gate * torch.clamp(v, max=1.0)
+
+
+def joint_limit_proximity_penalty(
+    env: ManagerBasedRlEnv,
+    margin: float = 0.08,
+    asset_cfg: SceneEntityCfg = SceneEntityCfg("robot", joint_names=(r".*hip_yaw.*", r".*hip_roll.*")),
+) -> torch.Tensor:
+    """-sum over the selected joints of (max(0, margin - distance to the nearer hard limit) / margin)^2.
+    Self-negating (<= 0): POSITIVE weight. AGENTS.md's fix for joints parking on hard limits (the stock
+    dof_pos_limits only fires in the last ~7.5 % of range). Run 3 iteration 2000 crouched with both hip yaws and both
+    hip rolls on their stops, the left hip yaw at 0.93 N.m peak / 0.39 N.m RMS: a servo pushing into its own stop."""
+    asset: Entity = env.scene[asset_cfg.name]
+    ids = asset_cfg.joint_ids
+    q = asset.data.joint_pos[:, ids]
+    lim = asset.data.joint_pos_limits[:, ids]          # (num_envs, n, 2)
+    dist = torch.minimum(q - lim[..., 0], lim[..., 1] - q)
+    return -(torch.clamp(margin - dist, min=0.0) / margin).pow(2).sum(-1)
+
+
+def action_target_overrun_l1(
+    env: ManagerBasedRlEnv,
+    limits: list,
+    action_name: str = "joint_pos",
+    asset_cfg: SceneEntityCfg = _DEFAULT_ASSET_CFG,
+) -> torch.Tensor:
+    """POSITIVE cost (-> negative weight): summed rad by which the RAW commanded target (default + action * scale)
+    exceeds each joint's range. The applied target is hard-clamped (BaseActionCfg.clip), so this teaches the network
+    itself to stay in range, which is what matters on the robot: robotd only clamps to the servo's full turn (±π).
+    (Same idea as the stomp env's action_target_overrun_l1 on emotions-stomp, summed instead of averaged.)"""
+    term = env.action_manager.get_term(action_name)
+    asset = env.scene[asset_cfg.name]
+    target = _servo_default_joint_pos(env, asset) + term.raw_action * float(getattr(term.cfg, "scale", 1.0))
+    lims = torch.tensor(limits, device=env.device, dtype=target.dtype)
+    over = torch.clamp(lims[:, 0].unsqueeze(0) - target, min=0.0) + torch.clamp(target - lims[:, 1].unsqueeze(0), min=0.0)
+    return torch.nan_to_num(over, nan=0.0).sum(dim=-1)
+
+
+# --------------------------------------------------------------------------- #
+# Expressive body motions (2026-10-28): phase-indexed reference tracking       #
+# --------------------------------------------------------------------------- #
+# The reference lives in tasks/expressive_motions.py (REF_CHANNELS: trunk roll / pitch / yaw-from-start / height
+# offset + the 4 head joints as offsets from HOME). The start heading and the start foot positions are captured
+# LAZILY in the first EX_CAPTURE_STEPS policy steps of each episode (the robot is dropped from 0.12-0.13 m at reset
+# and lands within ~3 steps), from inside the reward path, once per env step.
+from mjlab_microduck.tasks import expressive_motions as _exm
+
+EX_CAPTURE_STEPS = 6
+
+
+def _ex_trunk_rpy(env: ManagerBasedRlEnv) -> torch.Tensor:
+    """ZYX Euler (roll, pitch, yaw) of the root (trunk_base), (N, 3)."""
+    q = env.scene["robot"].data.root_link_quat_w
+    w, x, y, z = q[:, 0], q[:, 1], q[:, 2], q[:, 3]
+    roll = torch.atan2(2.0 * (w * x + y * z), 1.0 - 2.0 * (x * x + y * y))
+    pitch = torch.asin(torch.clamp(2.0 * (w * y - z * x), -1.0, 1.0))
+    yaw = torch.atan2(2.0 * (w * z + x * y), 1.0 - 2.0 * (y * y + z * z))
+    return torch.stack((roll, pitch, yaw), dim=-1)
+
+
+def _ex_feet_pos(env: ManagerBasedRlEnv) -> torch.Tensor:
+    robot: Entity = env.scene["robot"]
+    c = _ex_cache(env)
+    if "feet_ids" not in c:
+        c["feet_ids"] = robot.find_sites(("left_foot", "right_foot"), preserve_order=True)[0]
+    return robot.data.site_pos_w[:, c["feet_ids"], :]
+
+
+def _ex_cache(env: ManagerBasedRlEnv) -> dict:
+    c = getattr(env, "_ex_cache", None)
+    if c is None:
+        c = {"step": -1, "yaw0": torch.zeros(env.num_envs, device=env.device),
+             "feet0": torch.zeros(env.num_envs, 2, 3, device=env.device),
+             "root0": torch.zeros(env.num_envs, 2, device=env.device)}
+        env._ex_cache = c
+    return c
+
+
+def _ex_update(env: ManagerBasedRlEnv) -> dict:
+    """Capture the start heading / foot positions during the first steps of each episode (once per env step)."""
+    c = _ex_cache(env)
+    if c["step"] != env.common_step_counter:
+        c["step"] = env.common_step_counter
+        cap = env.episode_length_buf <= EX_CAPTURE_STEPS
+        if cap.any():
+            c["yaw0"] = torch.where(cap, _ex_trunk_rpy(env)[:, 2], c["yaw0"])
+            c["feet0"] = torch.where(cap[:, None, None], _ex_feet_pos(env), c["feet0"])
+            c["root0"] = torch.where(cap[:, None], env.scene["robot"].data.root_link_pos_w[:, :2], c["root0"])
+    return c
+
+
+def _ex_ref(env: ManagerBasedRlEnv, motion: str, command_name: str) -> torch.Tensor:
+    return _exm.reference(_exm.get_motion(motion), _gp_phase(env, command_name))
+
+
+def _ex_state(env: ManagerBasedRlEnv) -> torch.Tensor:
+    """Measured values in REF_CHANNELS order (offsets from the standing pose), (N, 8)."""
+    c = _ex_update(env)
+    robot: Entity = env.scene["robot"]
+    rpy = _ex_trunk_rpy(env)
+    yaw = torch.atan2(torch.sin(rpy[:, 2] - c["yaw0"]), torch.cos(rpy[:, 2] - c["yaw0"]))
+    dz = robot.data.root_link_pos_w[:, 2] - _ex_feet_pos(env)[:, :, 2].mean(dim=1) - _exm.STAND_HEIGHT
+    head = (_servo_joint_pos(env, robot) - _servo_default_joint_pos(env, robot))[:, 5:9]
+    return torch.cat((rpy[:, :2], yaw[:, None], dz[:, None], head), dim=-1)
+
+
+def ex_track(
+    env: ManagerBasedRlEnv,
+    motion: str,
+    channels: tuple,
+    std: float,
+    command_name: str = "twist",
+) -> torch.Tensor:
+    """Mean over `channels` of exp(-((measured - reference) / std)^2). Positive weight."""
+    idx = [_exm.CH[ch] for ch in channels]
+    err = (_ex_state(env) - _ex_ref(env, motion, command_name))[:, idx]
+    return torch.nan_to_num(torch.exp(-(err / std) ** 2).mean(dim=-1), nan=0.0)
+
+
+def ex_feet_drift(env: ManagerBasedRlEnv, max_dist: float = 0.05) -> torch.Tensor:
+    """COST (>= 0, negative weight): summed horizontal displacement of both feet from their start position (m)."""
+    c = _ex_update(env)
+    d = torch.linalg.norm(_ex_feet_pos(env)[:, :, :2] - c["feet0"][:, :, :2], dim=-1)
+    return torch.nan_to_num(torch.clamp(d, max=max_dist).sum(dim=-1), nan=0.0)
+
+
+def ex_feet_lift(env: ManagerBasedRlEnv, tol: float = 0.003, max_h: float = 0.05) -> torch.Tensor:
+    """COST (>= 0, negative weight): summed foot-site height above its start height, beyond `tol` (m)."""
+    c = _ex_update(env)
+    h = _ex_feet_pos(env)[:, :, 2] - c["feet0"][:, :, 2] - tol
+    return torch.nan_to_num(torch.clamp(h, min=0.0, max=max_h).sum(dim=-1), nan=0.0)
+
+
+def ex_foot_slip(env: ManagerBasedRlEnv) -> torch.Tensor:
+    """COST (>= 0, negative weight): summed horizontal foot-site speed (m/s); the feet are meant to stay planted."""
+    robot: Entity = env.scene["robot"]
+    _ex_feet_pos(env)
+    v = robot.data.site_lin_vel_w[:, _ex_cache(env)["feet_ids"], :2]
+    return torch.nan_to_num(torch.linalg.norm(v, dim=-1).sum(dim=-1), nan=0.0)
+
+
+def ex_settle_legs(
+    env: ManagerBasedRlEnv,
+    settle_from: float = 0.88,
+    ramp: float = 0.04,
+    std: float = 0.15,
+    command_name: str = "twist",
+) -> torch.Tensor:
+    """Back to the standing pose at the end: leg joints near HOME, gated (cosine ramp) for φ >= settle_from."""
+    robot: Entity = env.scene["robot"]
+    phi = _gp_phase(env, command_name)
+    gate = 0.5 - 0.5 * torch.cos(torch.pi * torch.clamp((phi - settle_from) / ramp, 0.0, 1.0))
+    dq = (_servo_joint_pos(env, robot) - _servo_default_joint_pos(env, robot))[:, [0, 1, 2, 3, 4, 9, 10, 11, 12, 13]]
+    return torch.nan_to_num(gate * torch.exp(-(dq / std) ** 2).mean(dim=-1), nan=0.0)
+
+
+def ex_reference_obs(env: ManagerBasedRlEnv, motion: str, command_name: str = "twist") -> torch.Tensor:
+    """Critic: the reference (8)."""
+    return torch.nan_to_num(_ex_ref(env, motion, command_name), nan=0.0)
+
+
+def ex_error_obs(env: ManagerBasedRlEnv, motion: str, command_name: str = "twist") -> torch.Tensor:
+    """Critic: measured - reference (8)."""
+    c = _ex_cache(env)
+    if c["step"] < 0:
+        return torch.zeros(env.num_envs, len(_exm.REF_CHANNELS), device=env.device)
+    return torch.nan_to_num(_ex_state(env) - _ex_ref(env, motion, command_name), nan=0.0)
+
+
+def ex_feet_offset_obs(env: ManagerBasedRlEnv) -> torch.Tensor:
+    """Critic: both feet's displacement from their start position (6)."""
+    c = _ex_cache(env)
+    if c["step"] < 0:
+        return torch.zeros(env.num_envs, 6, device=env.device)
+    return torch.nan_to_num((_ex_feet_pos(env) - c["feet0"]).reshape(env.num_envs, 6), nan=0.0)
+
+
+# ── Round 2 (2026-10-28 night): velocity tracking of the oscillations, head-dive guard, still settle ──────────────
+def _ex_rate(env: ManagerBasedRlEnv) -> torch.Tensor:
+    """Measured trunk rates (N, 4) in TRUNK_CHANNELS order: ZYX Euler rates (roll, pitch, yaw; rad/s) from the body
+    angular velocity, and d/dt of the dz channel (root z speed - mean foot-site z speed, m/s)."""
+    robot: Entity = env.scene["robot"]
+    rpy = _ex_trunk_rpy(env)
+    cr, sr = torch.cos(rpy[:, 0]), torch.sin(rpy[:, 0])
+    cp = torch.clamp(torch.cos(rpy[:, 1]), min=0.1)
+    tp = torch.sin(rpy[:, 1]) / cp
+    w = robot.data.root_link_ang_vel_b
+    p, q, r = w[:, 0], w[:, 1], w[:, 2]
+    droll = p + sr * tp * q + cr * tp * r
+    dpitch = cr * q - sr * r
+    dyaw = (sr * q + cr * r) / cp
+    _ex_feet_pos(env)
+    vz_feet = robot.data.site_lin_vel_w[:, _ex_cache(env)["feet_ids"], 2].mean(dim=1)
+    ddz = robot.data.root_link_lin_vel_w[:, 2] - vz_feet
+    return torch.stack((droll, dpitch, dyaw, ddz), dim=-1)
+
+
+def ex_track_rate(
+    env: ManagerBasedRlEnv,
+    motion: str,
+    channel: str,
+    std: float,
+    command_name: str = "twist",
+) -> torch.Tensor:
+    """exp(-((measured rate - reference rate) / std)^2) on one trunk channel. Positive weight. Rewards moving WITH
+    the reference's oscillation (phase and amplitude), which a position kernel narrower than the amplitude does not."""
+    i = _exm.TRUNK_CHANNELS.index(channel)
+    ref = _exm.reference_rate(_exm.get_motion(motion), _gp_phase(env, command_name))[:, _exm.CH[channel]]
+    err = _ex_rate(env)[:, i] - ref
+    return torch.nan_to_num(torch.exp(-(err / std) ** 2), nan=0.0)
+
+
+def ex_head_dev_cost(
+    env: ManagerBasedRlEnv,
+    motion: str,
+    channels: tuple = ("neck_pitch",),
+    free: float = 0.3,
+    command_name: str = "twist",
+) -> torch.Tensor:
+    """COST (>= 0, negative weight): summed |channel - reference| beyond `free` rad (round 1's neck dive). Any
+    REF_CHANNELS channel works: the head joints, or the trunk roll (the dance's right leans, 2026-10-30)."""
+    idx = [_exm.CH[ch] for ch in channels]
+    err = (_ex_state(env) - _ex_ref(env, motion, command_name))[:, idx]
+    return torch.nan_to_num(torch.clamp(err.abs() - free, min=0.0).sum(dim=-1), nan=0.0)
+
+
+def ex_settle_still(
+    env: ManagerBasedRlEnv,
+    settle_from: float = 0.88,
+    ramp: float = 0.04,
+    command_name: str = "twist",
+) -> torch.Tensor:
+    """COST (>= 0, negative weight): summed squared servo joint speed, gated (cosine ramp) for φ >= settle_from, so
+    the stand net receives a still robot at the hand-back."""
+    robot: Entity = env.scene["robot"]
+    phi = _gp_phase(env, command_name)
+    gate = 0.5 - 0.5 * torch.cos(torch.pi * torch.clamp((phi - settle_from) / ramp, 0.0, 1.0))
+    return torch.nan_to_num(gate * _servo_joint_vel(env, robot).pow(2).sum(dim=-1), nan=0.0)
+
+
+def ex_settle_legs_dev(
+    env: ManagerBasedRlEnv,
+    settle_from: float = 0.88,
+    ramp: float = 0.04,
+    free: float = 0.03,
+    command_name: str = "twist",
+) -> torch.Tensor:
+    """COST (>= 0, negative weight): summed |leg joint - HOME| beyond `free` rad over the 10 leg servos, gated (cosine
+    ramp) for φ >= settle_from: a LINEAR pull back to the stand pose for the hand-back (dance v3, 2026-10-30). The
+    Gaussian settle_legs kernel (std 0.15) has little gradient 0.2 rad away: the r2 dance ended ~13° off HOME at the
+    hips / ankles and the stand net stepped and turned up to 28° after φ = 1."""
+    robot: Entity = env.scene["robot"]
+    phi = _gp_phase(env, command_name)
+    gate = 0.5 - 0.5 * torch.cos(torch.pi * torch.clamp((phi - settle_from) / ramp, 0.0, 1.0))
+    dq = (_servo_joint_pos(env, robot) - _servo_default_joint_pos(env, robot))[:, [0, 1, 2, 3, 4, 9, 10, 11, 12, 13]]
+    return torch.nan_to_num(gate * torch.clamp(dq.abs() - free, min=0.0).sum(dim=-1), nan=0.0)
+
+
+# ── STEPPING dance (2026-10-30, branch dance-steps): contact schedule + foot targets ────────────────────────────────
+# The reference (expressive_motions.step_reference) gives, per foot, the horizontal DISPLACEMENT from its φ = 0 position
+# in the start heading frame, the swing clearance, the contact schedule (1 = loaded), and the root displacement.
+# Measured counterparts use the per-episode captures of _ex_update (feet0, root0, yaw0).
+def _ex_step_ref(env: ManagerBasedRlEnv, motion: str, command_name: str) -> torch.Tensor:
+    return _exm.step_reference(_exm.get_motion(motion), _gp_phase(env, command_name))
+
+
+def _ex_to_start_frame(env: ManagerBasedRlEnv, xy: torch.Tensor) -> torch.Tensor:
+    """Rotate world xy displacements (N, ..., 2) by -yaw0 (the start heading)."""
+    c = _ex_cache(env)
+    cy, sy = torch.cos(c["yaw0"]), torch.sin(c["yaw0"])
+    while cy.dim() < xy.dim() - 1:
+        cy, sy = cy.unsqueeze(-1), sy.unsqueeze(-1)
+    x, y = xy[..., 0], xy[..., 1]
+    return torch.stack((cy * x + sy * y, -sy * x + cy * y), dim=-1)
+
+
+def _ex_feet_step_state(env: ManagerBasedRlEnv):
+    """(disp (N, 2, 2) per-foot horizontal displacement in the start frame, clearance (N, 2) above the start height)."""
+    c = _ex_update(env)
+    feet = _ex_feet_pos(env)
+    disp = _ex_to_start_frame(env, feet[..., :2] - c["feet0"][..., :2])
+    return disp, feet[..., 2] - c["feet0"][..., 2]
+
+
+def _ex_ref_feet(ref: torch.Tensor):
+    disp = torch.stack((ref[:, [_exm.SC["lf_x"], _exm.SC["lf_y"]]], ref[:, [_exm.SC["rf_x"], _exm.SC["rf_y"]]]), dim=1)
+    clear = ref[:, [_exm.SC["lf_z"], _exm.SC["rf_z"]]]
+    contact = ref[:, [_exm.SC["l_contact"], _exm.SC["r_contact"]]]
+    return disp, clear, contact
+
+
+def _ex_contact_found(env: ManagerBasedRlEnv, sensor_name: str) -> torch.Tensor:
+    found = env.scene.sensors[sensor_name].data.found       # contact COUNT per foot (can exceed 1): -> 0 / 1
+    return (found.reshape(env.num_envs, -1)[:, :2] > 0).float()
+
+
+def ex_step_foot_track(env: ManagerBasedRlEnv, motion: str, std: float = 0.015,
+                       command_name: str = "twist") -> torch.Tensor:
+    """Mean over the feet of exp(-(|foot displacement - reference| / std)^2) (horizontal). Positive weight."""
+    disp, _ = _ex_feet_step_state(env)
+    rdisp, _, _ = _ex_ref_feet(_ex_step_ref(env, motion, command_name))
+    err = torch.linalg.norm(disp - rdisp, dim=-1)
+    return torch.nan_to_num(torch.exp(-(err / std) ** 2).mean(dim=-1), nan=0.0)
+
+
+def ex_step_foot_dev(env: ManagerBasedRlEnv, motion: str, free: float = 0.01,
+                     command_name: str = "twist") -> torch.Tensor:
+    """COST (>= 0): summed foot placement error beyond `free` (m), linear (gradient however far off)."""
+    disp, _ = _ex_feet_step_state(env)
+    rdisp, _, _ = _ex_ref_feet(_ex_step_ref(env, motion, command_name))
+    err = torch.linalg.norm(disp - rdisp, dim=-1)
+    return torch.nan_to_num(torch.clamp(err - free, min=0.0, max=0.2).sum(dim=-1), nan=0.0)
+
+
+def ex_step_contact(env: ManagerBasedRlEnv, motion: str, sensor_name: str = "feet_ground_contact",
+                    command_name: str = "twist") -> torch.Tensor:
+    """Mean over the feet of 1 - |contact found - scheduled contact| (the schedule is interpolated, so the frames
+    around a lift-off / touch-down give half credit). Positive weight."""
+    _, _, rc = _ex_ref_feet(_ex_step_ref(env, motion, command_name))
+    found = _ex_contact_found(env, sensor_name)
+    return torch.nan_to_num(1.0 - (found - rc).abs().mean(dim=-1), nan=0.0)
+
+
+def ex_step_clearance(env: ManagerBasedRlEnv, motion: str, std: float = 0.008,
+                      command_name: str = "twist") -> torch.Tensor:
+    """During a scheduled swing: exp(-((clearance - reference clearance) / std)^2), weighted by (1 - schedule) and
+    summed over the feet (0 when both feet are scheduled down). Positive weight: a foot that does not lift earns nothing."""
+    _, clear = _ex_feet_step_state(env)
+    _, rclear, rc = _ex_ref_feet(_ex_step_ref(env, motion, command_name))
+    k = torch.exp(-((clear - rclear) / std) ** 2)
+    return torch.nan_to_num(((1.0 - rc) * k).sum(dim=-1), nan=0.0)
+
+
+def ex_step_slip(env: ManagerBasedRlEnv, sensor_name: str = "feet_ground_contact",
+                 toe: float = 0.02) -> torch.Tensor:
+    """COST (>= 0): contact-gated foot slip: summed over feet in contact of the horizontal foot-site speed plus the
+    pivot speed |yaw rate| x `toe` (m/s). A step is fine, a slide or a pivot on a loaded foot is not."""
+    robot: Entity = env.scene["robot"]
+    _ex_feet_pos(env)
+    ids = _ex_cache(env)["feet_ids"]
+    v = torch.linalg.norm(robot.data.site_lin_vel_w[:, ids, :2], dim=-1)
+    w = robot.data.site_ang_vel_w[:, ids, 2].abs() if hasattr(robot.data, "site_ang_vel_w") else torch.zeros_like(v)
+    found = _ex_contact_found(env, sensor_name)
+    return torch.nan_to_num((found * (v + toe * w)).sum(dim=-1), nan=0.0)
+
+
+def ex_step_unscheduled_lift(env: ManagerBasedRlEnv, motion: str, tol: float = 0.003, max_h: float = 0.05,
+                             command_name: str = "twist") -> torch.Tensor:
+    """COST (>= 0): clearance beyond `tol` (m) of a foot scheduled to be DOWN (weighted by the schedule): no extra
+    steps, no shuffling."""
+    _, clear = _ex_feet_step_state(env)
+    _, _, rc = _ex_ref_feet(_ex_step_ref(env, motion, command_name))
+    return torch.nan_to_num((rc * torch.clamp(clear - tol, min=0.0, max=max_h)).sum(dim=-1), nan=0.0)
+
+
+def ex_step_root_track(env: ManagerBasedRlEnv, motion: str, std: float = 0.02,
+                       command_name: str = "twist") -> torch.Tensor:
+    """exp(-(|root displacement - reference| / std)^2) (horizontal, start frame): the weight shifts / lunges."""
+    c = _ex_update(env)
+    d = _ex_to_start_frame(env, env.scene["robot"].data.root_link_pos_w[:, :2] - c["root0"])
+    ref = _ex_step_ref(env, motion, command_name)[:, [_exm.SC["root_x"], _exm.SC["root_y"]]]
+    return torch.nan_to_num(torch.exp(-(torch.linalg.norm(d - ref, dim=-1) / std) ** 2), nan=0.0)
+
+
+def ex_step_ref_obs(env: ManagerBasedRlEnv, motion: str, command_name: str = "twist") -> torch.Tensor:
+    """Critic: the step reference (12)."""
+    return torch.nan_to_num(_ex_step_ref(env, motion, command_name), nan=0.0)
+
+
+def ex_step_err_obs(env: ManagerBasedRlEnv, motion: str, sensor_name: str = "feet_ground_contact",
+                    command_name: str = "twist") -> torch.Tensor:
+    """Critic: foot displacement error (4), clearance error (2), contact found (2)."""
+    c = _ex_cache(env)
+    if c["step"] < 0:
+        return torch.zeros(env.num_envs, 8, device=env.device)
+    disp, clear = _ex_feet_step_state(env)
+    rdisp, rclear, _ = _ex_ref_feet(_ex_step_ref(env, motion, command_name))
+    out = torch.cat(((disp - rdisp).reshape(env.num_envs, 4), clear - rclear, _ex_contact_found(env, sensor_name)), dim=-1)
+    return torch.nan_to_num(out, nan=0.0)
