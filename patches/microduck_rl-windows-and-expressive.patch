diff --git a/tests/test_retargeted_motions.py b/tests/test_retargeted_motions.py
new file mode 100644
index 0000000..c5a374b
--- /dev/null
+++ b/tests/test_retargeted_motions.py
@@ -0,0 +1,100 @@
+"""The motions retargeted from human motion must obey the same contract as
+the shipped ones: they start and end STILL at the stand, the head joints stay
+inside their limits with margin, the rates stay under the overspeed
+threshold, and -- for the stepping ones -- the feet are never both off the
+ground.
+
+The upstream test (test_expressive_dance.py) is parameterised on the SHIPPED
+motions and their reference bounds, because a growing library must not change
+what those bounds mean. These motions were added on top of the shipped ones,
+so they are checked here, against the same rules.
+"""
+
+import numpy as np
+import pytest
+import torch
+
+import mjlab_microduck.tasks  # noqa: F401  (registry first)
+from mjlab_microduck.tasks.expressive_motions import (
+    CH, HEAD_JOINTS, STEP_COLS, DataMotion, StepMotion, get_motion, reference, reference_rate,
+)
+from mjlab_microduck.tasks.microduck_expressive_env_cfg import expressive_joint_limits
+
+# The retargeted motions, and whether they carry the step channels.
+RETARGETED = {
+    "DemoSway": False,        # expressive: the body and head move, the feet stay planted
+    "DemoWalk": True,         # stepping, from a human walk
+    "SomaWalkForward": True,  # stepping, from NVIDIA's SOMA retargeter
+}
+
+
+def _phi(mo, n=None):
+    n = n or int(mo.period * 200) + 1
+    return torch.linspace(0.0, 1.0, n, dtype=torch.float64)
+
+
+@pytest.mark.parametrize("name", list(RETARGETED))
+def test_registered_and_looked_up(name):
+    mo = get_motion(name)
+    assert isinstance(mo, DataMotion)
+    assert mo.period > 0.0
+    if RETARGETED[name]:
+        assert isinstance(mo, StepMotion)
+
+
+@pytest.mark.parametrize("name", list(RETARGETED))
+def test_starts_and_ends_still_at_stand(name):
+    mo = get_motion(name)
+    phi = _phi(mo)
+    r, d = reference(mo, phi).numpy(), reference_rate(mo, phi).numpy()
+    # Starts at the stand, with no slope: the duck is not yanked the moment
+    # the episode begins.
+    assert np.abs(r[0]).max() < 1e-6, (name, r[0])
+    assert np.abs(d[0]).max() < 1e-6, (name, d[0])
+    # And it is back at the stand, still, before the hand-back.
+    late = phi.numpy() >= mo.settle_from - 0.005
+    assert late.sum() > 10
+    assert np.abs(r[late]).max() < 1e-6, (name, np.abs(r[late]).max())
+    assert np.abs(d[late]).max() < 1e-6, (name, np.abs(d[late]).max())
+
+
+@pytest.mark.parametrize("name", list(RETARGETED))
+def test_head_joints_stay_inside_their_limits(name):
+    mo = get_motion(name)
+    r = reference(mo, _phi(mo)).numpy()
+    lim = expressive_joint_limits(getattr(mo, "hip_roll_range", None))
+    for jn in HEAD_JOINTS:
+        q = r[:, CH[jn]]
+        assert q.min() >= lim[jn][0] + 0.05, (name, jn, q.min(), lim[jn][0])
+        assert q.max() <= lim[jn][1] - 0.05, (name, jn, q.max(), lim[jn][1])
+
+
+@pytest.mark.parametrize("name", list(RETARGETED))
+def test_rates_stay_under_the_overspeed_threshold(name):
+    mo = get_motion(name)
+    d = reference_rate(mo, _phi(mo)).numpy()
+    for ch in ("roll", "pitch", "yaw") + HEAD_JOINTS:
+        assert np.abs(d[:, CH[ch]]).max() <= mo.overspeed * 1.1, (name, ch)
+
+
+@pytest.mark.parametrize("name", [k for k, v in RETARGETED.items() if v])
+def test_stepping_feet_are_never_both_off_the_ground(name):
+    """A duck with both feet in the air falls over, so the contact schedule
+    must never leave both feet swinging."""
+    from mjlab_microduck.tasks.expressive_motions import step_reference
+
+    mo = get_motion(name)
+    phi = _phi(mo)
+    ref = step_reference(mo, phi).numpy()
+    l = ref[:, STEP_COLS.index("l_contact")]
+    r = ref[:, STEP_COLS.index("r_contact")]
+    both_swing = (l < 0.5) & (r < 0.5)
+    assert both_swing.sum() == 0, (name, both_swing.sum())
+    # And each foot does step at least a couple of times. The reference
+    # interpolates the schedule, so a lift-off shows up as a fractional ramp
+    # over a sample or two: count the transitions of the PLANTED state, not
+    # the size of the jump.
+    for c, label in ((l, "left"), (r, "right")):
+        planted = c > 0.5
+        switches = int(np.sum(planted[1:] != planted[:-1]))
+        assert switches >= 2, (name, label, switches)
