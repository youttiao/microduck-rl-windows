diff --git a/pyproject.toml b/pyproject.toml
index 1c26ecd..0481b69 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -75,8 +75,21 @@ better-actuator-models = { git = "https://github.com/Rhoban/bam.git", rev = "62b
 # zero-copy warp<->torch interop stays on one runtime major version.
 # The marker keeps x86_64 (HF Jobs) on PyPI, where the wheel already bundles
 # CUDA via its nvidia-*-cu12 deps — that resolution is unchanged.
+# On win32 (x86_64) PyPI's torch wheel is ALSO CPU-ONLY, for a different
+# reason: the nvidia-*-cu12 dependency mechanism does not exist on Windows,
+# where a torch wheel is self-contained. `pip install torch` on Windows from
+# PyPI therefore yields `2.9.1+cpu` with torch.version.cuda is None, the
+# same dead end as aarch64 -> mjlab's select_gpus() indexes an empty list ->
+# IndexError before training starts (mjlab/utils/gpu.py:70).
+# Route torch to PyTorch's CUDA index there too.
+# cu128 (not cu130) is the closest published 12.x Windows build to the CUDA
+# toolkit warp 1.12.0 bundles (12.9): torch has no cu129 Windows wheel, and
+# cu130 would put torch on a different CUDA MAJOR than warp, which the
+# zero-copy warp<->torch interop needs to share. cu128 is also the canonical
+# Blackwell build (sm_120, the RTX 50-series).
 torch = [
   { index = "pytorch-cu129", marker = "sys_platform == 'linux' and platform_machine == 'aarch64'" },
+  { index = "pytorch-cu128", marker = "sys_platform == 'win32'" },
 ]
 
 [[tool.uv.index]]
@@ -84,3 +97,9 @@ name = "pytorch-cu129"
 url = "https://download.pytorch.org/whl/cu129"
 # explicit: only packages that name this index resolve from it.
 explicit = true
+
+[[tool.uv.index]]
+name = "pytorch-cu128"
+url = "https://download.pytorch.org/whl/cu128"
+# explicit: only packages that name this index resolve from it.
+explicit = true
